      "title": "Golden Leftover Egg Fried Rice",
      "name": "Golden Leftover Egg Fried Rice",
      "description": "Quick 10-minute fried rice utilizing leftover Basmati rice, fresh eggs, and crisp baby spinach!",
      "category": "Rice",
      "mealType": "Lunch",
      "imageUrl": "https://images.unsplash.com/photo-1603133872878-684f208fb84b?auto=format&fit=crop&w=600&q=80",
      "prepTimeMinutes": 5,
      "cookTimeMinutes": 10,
      "calories": 420,
      "proteinGrams": 16,
      "carbsGrams": 58,
      "fatGrams": 12,
      "servings": 2,
      "difficulty": "Easy",
      "ingredients": [
        { "name": "Cooked Basmati Rice", "quantity": 1, "unit": "bowl" },
        { "name": "Organic Large Eggs", "quantity": 2, "unit": "pcs" },
        { "name": "Soy Sauce", "quantity": 1, "unit": "tbsp" },
        { "name": "Fresh Baby Spinach", "quantity": 50, "unit": "g" }
      ],
      "instructions": [
        "Heat sesame oil in a large wok over medium-high heat.",
        "Add spinach leaves and stir fry for 1 minute until wilted.",
        "Push spinach to the side, crack in eggs, and scramble gently.",
